# The signing secret Roddy showed you ONCE when the webhook was verified.
WEBHOOK_SECRET=

# --- Notify access (optional here) ---
# Leave these unset on your own machine: the skill reads the same config the
# `notify` CLI already wrote at ~/.config/rodai-notify/config.json.
# Set them only when deploying somewhere that has no CLI config — and never
# commit the values.
#   RODAI_NOTIFY_TOKEN=
#   RODAI_NOTIFY_URL=https://rodainotify.com
