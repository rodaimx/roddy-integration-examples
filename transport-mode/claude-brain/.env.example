# --- Recibir eventos ---
# El secreto que Roddy mostró UNA vez al verificar el webhook.
WEBHOOK_SECRET=

# --- Responder por el send API ---
# Vienen en el .env que descargas al crear la integración en el dashboard
# (Integraciones -> nueva -> scope channel.send -> generar credenciales).
AUTH_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# Host de la API — DISTINTO al de AUTH_TOKEN_URL.
RODDY_API_BASE_URL=

# --- El cerebro ---
CLAUDE_BIN=/Users/david/.local/bin/claude
# Directorio donde corre el agente. Aislado a propósito: si habilitas
# herramientas, este es el radio de daño.
CLAUDE_WORKDIR=/tmp/roddy-claude-brain
# ""            = sin herramientas (solo conversa)
# "Read Glob"   = solo esas
# "UNRESTRICTED"= todas, incl. Bash, vía --dangerously-skip-permissions
CLAUDE_ALLOWED_TOOLS=
