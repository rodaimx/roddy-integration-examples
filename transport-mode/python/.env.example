# --- Receiving events (receiver.py) ---
# The signing secret shown once when you verified your webhook.
WEBHOOK_SECRET=

# --- Sending via the API (send_example.py) ---
# AUTH_TOKEN_URL + CLIENT_ID + CLIENT_SECRET come in the .env you download when
# you create the integration (Integrations -> your integration -> credentials).
# AUTH_TOKEN_URL is the full token endpoint and ends in /o/token/.
AUTH_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
# The Roddy API base — a DIFFERENT host from AUTH_TOKEN_URL.
RODDY_API_BASE_URL=
# The channel + contact you're replying on (both arrive in the message.inbound event).
CHANNEL_ID=
CONTACT_ID=
