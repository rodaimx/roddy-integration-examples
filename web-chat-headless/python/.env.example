# The web-chat endpoint base (its own host — NOT the Roddy REST API).
# Copy it from your Roddy app: Canales → your web chat → "Datos para tu backend".
RODDY_WEB_CHAT_URL=

# The web-chat channel to talk to — same place, "ID del canal".
CHANNEL_ID=

# --- Visitor mode (chat.py / mint_token.py) ---------------------------------
# The channel's visitor secret: channel settings → "Secreto de visitante".
# Server-side only. Rotating it invalidates tokens signed with the old one.
CHANNEL_VISITOR_SECRET=
VISITOR_USER_ID=demo-user-1
VISITOR_NAME=Demo

# --- Integration mode (integration_example.py) ------------------------------
# OAuth client-credentials of an integration whose app holds `web_chat.converse`.
# AUTH_TOKEN_URL is the full token endpoint (ends in /o/token/).
AUTH_TOKEN_URL=
CLIENT_ID=
CLIENT_SECRET=
SUBJECT=crm-user-42
# Display hints for that same person: what your operators and the agent
# see instead of the raw id. Optional, but an inbox of ids is the cost of
# leaving them out — and the stand-in name sticks to the contact.
SUBJECT_NAME=Usuario CRM 42
SUBJECT_EMAIL=
