# The web-chat endpoint base (its own host — NOT the Roddy REST API).
# Shown in your Roddy app under Docs → Referencia → API de chat web,
# and on the channel page under "Datos para tu backend".
RODDY_WEB_CHAT_URL=

# The web_chat channel with access_mode "visitor_token".
CHANNEL_ID=

# The channel's visitor secret (channel settings → "Secreto de visitante").
# SERVER-SIDE ONLY. This file is read by server/server.js and nothing from it
# ever reaches the browser except short-lived signed tokens.
CHANNEL_VISITOR_SECRET=

# Local port for the Acme API (the Vite dev server proxies /api here).
PORT=8787
